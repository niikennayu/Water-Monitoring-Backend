    "helmet": "^7.1.0",
    "express-validator": "^7.0.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "prisma": "^5.7.0",
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0"
  }
